DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Comma-separated Discord forum channel IDs. Only these forums are processed.
FORUM_CHANNEL_IDS=123456789012345678,234567890123456789
OPENROUTER_MODEL=openai/gpt-6-luna
# Maximum tags the AI may choose (1-5).
MAX_AI_TAGS=3
# add: keep existing tags and add AI tags. replace: swap all non-moderator-only tags.
TAG_MODE=add
# Comma-separated Discord user IDs allowed to run /autotag. Empty disables the commands.
COMMAND_USER_IDS=
# Posts tagged at the same time (1-10).
TAG_CONCURRENCY=4
# Duplicate detection (off/on). Stores encrypted embeddings; update your Privacy
# Policy before enabling. Generate a key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUPLICATES=off
DUPLICATE_DB_KEY=
# Minimum similarity (0.5-0.99) for the bot to reply with related posts.
DUPLICATE_THRESHOLD=0.7
# Most similar posts linked in a reply (1-10).
DUPLICATE_MAX_MATCHES=5
# Posts indexed at the same time (1-20).
INDEX_CONCURRENCY=10
