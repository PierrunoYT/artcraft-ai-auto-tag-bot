DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Comma-separated Discord forum channel IDs. Only these forums are processed.
FORUM_CHANNEL_IDS=123456789012345678,234567890123456789
OPENROUTER_MODEL=openai/gpt-6-luna
# Maximum tags the AI may choose (1-5).
MAX_AI_TAGS=3
# add: keep existing tags and add AI tags. replace: swap all non-moderator-only tags.
TAG_MODE=add
# Comma-separated Discord user IDs allowed to run /autotag. Empty disables the commands.
COMMAND_USER_IDS=
# Posts tagged at the same time (1-10).
TAG_CONCURRENCY=4
# Duplicate detection (off/on). Stores encrypted embeddings; update your Privacy
# Policy before enabling. Generate a key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUPLICATES=off
DUPLICATE_DB_KEY=
# Minimum embedding similarity (0.2-0.95) to shortlist a post for the AI duplicate check.
DUPLICATE_THRESHOLD=0.45
# Candidates per new post sent to the AI duplicate check (1-25).
DUPLICATE_CANDIDATES=10
# Most similar posts linked in a reply (1-10).
DUPLICATE_MAX_MATCHES=5
# Cross-link duplicate groups: on (all posts), active (skip archived), off (new post only).
DUPLICATE_CROSS_LINK=on
# Compare posts across all configured forums (all) or only within the same forum (forum).
DUPLICATE_SCOPE=all
# Action journal for resuming runs, catching up after downtime, and undo (IDs only).
STATE_DB_PATH=artcraft_state.db
# Days to keep journal entries (1-3650); 0 keeps them forever.
ACTION_RETENTION_DAYS=90
# Handle posts created while the bot was offline (on/off).
CATCH_UP=on
# Posts indexed at the same time (1-20).
INDEX_CONCURRENCY=10
